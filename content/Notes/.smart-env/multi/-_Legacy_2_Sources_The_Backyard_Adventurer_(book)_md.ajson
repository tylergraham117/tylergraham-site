2,0.04348878,0.00093104,-0.05701559,0.02631567,0.05096629,0.16383332,0.01368276,-0.03932561,0.02523332,-0.01585973,0.02681221,-0.02571575,-0.03169071,0.02484182,-0.03006382,0.12299372,-0.01670431,0.01558605,-0.03606877,-0.04328611,0.00404629,-0.00428343,-0.04599042,0.01528901,0.02398616,0.02005232,0.08658805,0.14990164,-0.04464616,-0.02387968,-0.0124889,-0.05008515,0.0339107,-0.00177184,-0.00952817,-0.00291618,0.01946435,0.02052199,0.06825285,0.02820632,0.00456785,-0.05392174,0.01577737,-0.01608826,-0.03554508,0.06308936,0.01358949,0.01708782],"last_embed":{"hash":"0d3e3c59652bcf684011b2b14c516f645fd7248b8e2d85f7a5600005a908b140","tokens":442}}},"last_read":{"hash":"0d3e3c59652bcf684011b2b14c516f645fd7248b8e2d85f7a5600005a908b140","at":1738253749263},"class_name":"SmartSource","outlinks":[{"title":"Sources MOC","target":"Sources MOC","line":6},{"title":"Beau Miles","target":"Beau Miles","line":7},{"title":"adventure is both insignificant and greatly important","target":"adventure is both insignificant and greatly important","line":19},{"title":"focused action leads to presence","target":"focused action leads to presence","line":20},{"title":"authenticity in the face of reality leads to good storytelling","target":"authenticity in the face of reality leads to good storytelling","line":21},{"title":"everything is a waste of time unless you decide it isn't","target":"everything is a waste of time unless you decide it isn't","line":22},{"title":"we must be challenged to be engaged","target":"we must be challenged to be engaged","line":23},{"title":"the world is not so segmented","target":"the world is not so segmented","line":24},{"title":"Reflection is a crucial part of life, but it doesn't come naturally.","target":"Reflection is a crucial part of life, but it doesn't come naturally.","line":25},{"title":"the mundane can be exciting if we approach it right","target":"the mundane can be exciting if we approach it right","line":26},{"title":"people store memories in objects and people","target":"people store memories in objects and people","line":27},{"title":"I started exploring new ways of thinking, questioning what to do, why, when to do it, and really, Beau, what's the bloody point to all this questioning?","target":"I started exploring new ways of thinking, questioning what to do, why, when to do it, and really, Beau, what's the bloody point to all this questioning?","line":55},{"title":"Near-misses come and go, so you harden up a little and learn as only fools and experts can.","target":"Near-misses come and go, so you harden up a little and learn as only fools and experts can.","line":57},{"title":"You forget to drink when you're always wet, or looking at a vast desert of liquid.","target":"You forget to drink when you're always wet, or looking at a vast desert of liquid.","line":59},{"title":"Such a breakthrough in thinking is to acknowledge that I have a uniqueness born of influences.","target":"Such a breakthrough in thinking is to acknowledge that I have a uniqueness born of influences.","line":61},{"title":"You come to rely on gadgets and digital numbers like grease on lips and milk on cereal, and I don't like the feeling when the batteries die, as if you've lost part of your brain.","target":"You come to rely on gadgets and digital numbers like grease on lips and milk on cereal, and I don't like the feeling when the batteries die, as if you've lost part of your brain.","line":63}],"last_import":{"mtime":1727194767114,"size":1515,"at":1738253736159,"hash":"0d3e3c59652bcf684011b2b14c516f645fd7248b8e2d85f7a5600005a908b140"},"blocks":{"#---frontmatter---":[1,8],"#The Backyard Adventurer":[9,76],"#The Backyard Adventurer##Summary":[12,17],"#The Backyard Adventurer##Main Ideas":[18,29],"#The Backyard Adventurer##Main Ideas#{1}":[19,19],"#The Backyard Adventurer##Main Ideas#{2}":[20,20],"#The Backyard Adventurer##Main Ideas#{3}":[21,21],"#The Backyard Adventurer##Main Ideas#{4}":[22,22],"#The Backyard Adventurer##Main Ideas#