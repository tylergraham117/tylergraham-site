,-0.00244838,-0.05197708,0.01555889,0.05951657,0.17001015,0.01017351,-0.01055521,0.02989714,-0.01697654,0.03244287,-0.00886316,-0.02978608,0.02131364,-0.00928022,0.06353927,-0.04354179,0.03094516,-0.01370202,-0.06442573,0.01253246,0.00827178,-0.05031271,0.03974212,-0.00496076,-0.03338336,0.07527242,0.13805678,-0.02342994,-0.00778914,-0.04727181,-0.02558837,0.01151616,0.01040566,-0.00498454,0.001451,0.01986784,0.03771091,0.05612887,-0.01042148,-0.00862187,-0.0167341,0.03175376,0.02998001,-0.030549,0.09111505,0.04960891,0.02341827],"last_embed":{"hash":"a709e756a42f740ef7b50a4b0c20711767313195f44365a110e0b784cd5338b0","tokens":184}}},"text":null,"length":0,"last_read":{"hash":"a709e756a42f740ef7b50a4b0c20711767313195f44365a110e0b784cd5338b0","at":1738253749263},"key":"- Legacy 2/Sources/The Backyard Adventurer (book).md#The Backyard Adventurer##Information Dump#{1}","lines":[55,69],"size":634,"outlinks":[{"title":"I started exploring new ways of thinking, questioning what to do, why, when to do it, and really, Beau, what's the bloody point to all this questioning?","target":"I started exploring new ways of thinking, questioning what to do, why, when to do it, and really, Beau, what's the bloody point to all this questioning?","line":1},{"title":"Near-misses come and go, so you harden up a little and learn as only fools and experts can.","target":"Near-misses come and go, so you harden up a little and learn as only fools and experts can.","line":3},{"title":"You forget to drink when you're always wet, or looking at a vast desert of liquid.","target":"You forget to drink when you're always wet, or looking at a vast desert of liquid.","line":5},{"title":"Such a breakthrough in thinking is to acknowledge that I have a uniqueness born of influences.","target":"Such a breakthrough in thinking is to acknowledge that I have a uniqueness born of influences.","line":7},{"title":"You come to rely on gadgets and digital numbers like grease on lips and milk on cereal, and I don't like the feeling when the batteries die, as if you've lost part of your brain.","target":"You come to rely on gadgets and digital numbers like grease on lips and milk on cereal, and I don't like the feeling when the batteries die, as if you've lost part of your brain.","line":9}],"class_name":"SmartBlock"},
