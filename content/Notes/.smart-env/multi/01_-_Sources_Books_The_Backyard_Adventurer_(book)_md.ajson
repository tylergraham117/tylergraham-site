12,0.00767177,-0.04287184,0.04934319,0.0561631,0.17513689,0.00335737,-0.02472377,0.03391231,-0.00866338,0.0098367,-0.04796011,-0.02666437,0.04717582,-0.02915969,0.10850938,0.00620554,0.03114201,-0.03725193,-0.0474835,0.00012878,0.00892825,-0.04778562,0.00760977,0.01558089,0.04825922,0.07610621,0.13823825,-0.03479693,-0.03444084,-0.02944602,-0.0657244,0.030371,-0.00800574,-0.01435341,0.00411121,0.01432907,0.01543758,0.07216522,0.01458066,0.00212362,-0.06450851,0.01014955,-0.00995934,-0.05253603,0.05836678,-0.00416548,0.01376356],"last_embed":{"hash":"v7gg0q","tokens":445}}},"last_read":{"hash":"v7gg0q","at":1760809348524},"class_name":"SmartSource","outlinks":[{"title":"Sources MOC","target":"Sources MOC","line":6},{"title":"Beau Miles","target":"Beau Miles","line":7},{"title":"adventure is both insignificant and greatly important","target":"adventure is both insignificant and greatly important","line":19},{"title":"focused action leads to presence","target":"focused action leads to presence","line":20},{"title":"authenticity in the face of reality leads to good storytelling","target":"authenticity in the face of reality leads to good storytelling","line":21},{"title":"everything is a waste of time unless you decide it isn't","target":"everything is a waste of time unless you decide it isn't","line":22},{"title":"we must be challenged to be engaged","target":"we must be challenged to be engaged","line":23},{"title":"the world is not so segmented","target":"the world is not so segmented","line":24},{"title":"Reflection is a crucial part of life, but it doesn't come naturally.","target":"Reflection is a crucial part of life, but it doesn't come naturally.","line":25},{"title":"the mundane can be exciting if we approach it right","target":"the mundane can be exciting if we approach it right","line":26},{"title":"people store memories in objects and people","target":"people store memories in objects and people","line":27},{"title":"I started exploring new ways of thinking, questioning what to do, why, when to do it, and really, Beau, what's the bloody point to all this questioning?","target":"I started exploring new ways of thinking, questioning what to do, why, when to do it, and really, Beau, what's the bloody point to all this questioning?","line":55},{"title":"Near-misses come and go, so you harden up a little and learn as only fools and experts can.","target":"Near-misses come and go, so you harden up a little and learn as only fools and experts can.","line":57},{"title":"You forget to drink when you're always wet, or looking at a vast desert of liquid.","target":"You forget to drink when you're always wet, or looking at a vast desert of liquid.","line":59},{"title":"Such a breakthrough in thinking is to acknowledge that I have a uniqueness born of influences.","target":"Such a breakthrough in thinking is to acknowledge that I have a uniqueness born of influences.","line":61},{"title":"You come to rely on gadgets and digital numbers like grease on lips and milk on cereal, and I don't like the feeling when the batteries die, as if you've lost part of your brain.","target":"You come to rely on gadgets and digital numbers like grease on lips and milk on cereal, and I don't like the feeling when the batteries die, as if you've lost part of your brain.","line":63}],"last_import":{"mtime":1750955074796,"size":1519,"at":1760809343995,"hash":"v7gg0q"},"blocks":{"#---frontmatter---":[1,8],"#The Backyard Adventurer":[9,76],"#The Backyard Adventurer##Summary":[12,17],"#The Backyard Adventurer##Main Ideas":[18,29],"#The Backyard Adventurer##Main Ideas#{1}":[19,19],"#The Backyard Adventurer##Main Ideas#{2}":[20,20],"#The Backyard Adventurer##Main Ideas#{3}":[21,21],"#The Backyard Adventurer##Main Ideas#{4}":[22,22],"#The Backyard Adventurer##Main Ideas#{5}":[23,23],"#The Backyard Adventurer##Main Ideas#{6}":[24,24],"#The Backyard Adventurer##Main Ideas#{7}":[25,25],"#The Backyard Adventurer##Main Ideas#{8}":[26,26],"#The Backyard Adventurer##Main Ideas#{9}":[27,29],"#The Backyard Adventurer##Tools":[30,37],"#The Backyard Adventurer##Tools#{1}":[31,37],"#The Backyard Adventurer##Chapters":[38,52],"#The Backyard Adventurer##Chapters#{1}":[39,39],"#The Backyard Adventurer##Chapters#{2}":[40,40],"#The Backyard Adventurer##Chapters#{3}":[41,41],"#The Backyard Adventurer##Chapters#{4}":[42,42],"#The Backyard Adventurer##Chapters#{5}":[43,43],"#The Backyard Adventurer##Chapters#{6}":[44,44],"#The Backyard Adventurer##Chapters#{7}":[45,45],"#The Backyard Adventurer##Chapters#{8}":[46,46],"#The Backyard Adventurer##Chapters#{9}":[47,50],"#The Backyard Adventurer##Chapters#{10}":[51,52],"#The Backyard Adventurer##Information Dump":[53,69],"#The Backyard Adventurer##Information Dump#{1}":[55,69],"#The Backyard Adventurer##Notes on Writing":[70,76]},"key":"01 - Sources/Books/The Backyard Adventurer (book).md","metadata":{"date":"2021-06-22","tags":["#source/book","on/adventure"],"up":"[[Sources MOC]]","author":"[[Beau Miles]]"},"last_embed":{"hash":"v7gg0q","at":1760809348494}},
