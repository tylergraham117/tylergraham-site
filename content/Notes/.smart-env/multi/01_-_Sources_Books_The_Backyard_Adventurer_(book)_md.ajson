,0.01882165,0.00442601,-0.04002634,0.03207733,0.06579912,0.1767083,0.00283649,0.00378859,0.03578293,-0.01098122,0.01809011,-0.03016658,-0.02561435,0.03869624,-0.00881391,0.051086,-0.0250098,0.04495044,-0.0151926,-0.07421138,0.00699152,0.02431312,-0.0548202,0.03585224,-0.01604384,-0.01237791,0.06713856,0.13151106,-0.01820491,-0.01117912,-0.06746794,-0.03992278,0.00664928,0.00402887,-0.00754281,0.01153939,0.01665917,0.03770304,0.06186956,-0.02314337,-0.01084755,-0.02116128,0.02490746,0.03281699,-0.04676434,0.09214742,0.03553987,0.02307791],"last_embed":{"hash":"1mpafh7","tokens":187}}},"text":null,"length":0,"last_read":{"hash":"1mpafh7","at":1760809348524},"key":"01 - Sources/Books/The Backyard Adventurer (book).md#The Backyard Adventurer##Information Dump#{1}","lines":[55,69],"size":638,"outlinks":[{"title":"I started exploring new ways of thinking, questioning what to do, why, when to do it, and really, Beau, what's the bloody point to all this questioning?","target":"I started exploring new ways of thinking, questioning what to do, why, when to do it, and really, Beau, what's the bloody point to all this questioning?","line":1},{"title":"Near-misses come and go, so you harden up a little and learn as only fools and experts can.","target":"Near-misses come and go, so you harden up a little and learn as only fools and experts can.","line":3},{"title":"You forget to drink when you're always wet, or looking at a vast desert of liquid.","target":"You forget to drink when you're always wet, or looking at a vast desert of liquid.","line":5},{"title":"Such a breakthrough in thinking is to acknowledge that I have a uniqueness born of influences.","target":"Such a breakthrough in thinking is to acknowledge that I have a uniqueness born of influences.","line":7},{"title":"You come to rely on gadgets and digital numbers like grease on lips and milk on cereal, and I don't like the feeling when the batteries die, as if you've lost part of your brain.","target":"You come to rely on gadgets and digital numbers like grease on lips and milk on cereal, and I don't like the feeling when the batteries die, as if you've lost part of your brain.","line":9}],"class_name":"SmartBlock","last_embed":{"hash":"1mpafh7","at":1760809348524}},