
"smart_sources:01 - Sources/Books/The Backyard Adventurer (book).md": {"path":"01 - Sources/Books/The Backyard Adventurer (book).md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"0d3e3c59652bcf684011b2b14c516f645fd7248b8e2d85f7a5600005a908b140","at":1738253736179},"class_name":"SmartSource","outlinks":[{"title":"Sources MOC","target":"Sources MOC","line":6},{"title":"Beau Miles","target":"Beau Miles","line":7},{"title":"adventure is both insignificant and greatly important","target":"adventure is both insignificant and greatly important","line":19},{"title":"focused action leads to presence","target":"focused action leads to presence","line":20},{"title":"authenticity in the face of reality leads to good storytelling","target":"authenticity in the face of reality leads to good storytelling","line":21},{"title":"everything is a waste of time unless you decide it isn't","target":"everything is a waste of time unless you decide it isn't","line":22},{"title":"we must be challenged to be engaged","target":"we must be challenged to be engaged","line":23},{"title":"the world is not so segmented","target":"the world is not so segmented","line":24},{"title":"Reflection is a crucial part of life, but it doesn't come naturally.","target":"Reflection is a crucial part of life, but it doesn't come naturally.","line":25},{"title":"the mundane can be exciting if we approach it right","target":"the mundane can be exciting if we approach it right","line":26},{"title":"people store memories in objects and people","target":"people store memories in objects and people","line":27},{"title":"I started exploring new ways of thinking, questioning what to do, why, when to do it, and really, Beau, what's the bloody point to all this questioning?","target":"I started exploring new ways of thinking, questioning what to do, why, when to do it, and really, Beau, what's the bloody point to all this questioning?","line":55},{"title":"Near-misses come and go, so you harden up a little and learn as only fools and experts can.","target":"Near-misses come and go, so you harden up a little and learn as only fools and experts can.","line":57},{"title":"You forget to drink when you're always wet, or looking at a vast desert of liquid.","target":"You forget to drink when you're always wet, or looking at a vast desert of liquid.","line":59},{"title":"Such a breakthrough in thinking is to acknowledge that I have a uniqueness born of influences.","target":"Such a breakthrough in thinking is to acknowledge that I have a uniqueness born of influences.","line":61},{"title":"You come to rely on gadgets and digital numbers like grease on lips and milk on cereal, and I don't like the feeling when the batteries die, as if you've lost part of your brain.","target":"You come to rely on gadgets and digital numbers like grease on lips and milk on cereal, and I don't like the feeling when the batteries die, as if you've lost part of your brain.","line":63}],"last_import":{"mtime":1730907879350,"size":1515,"at":1738253736179,"hash":"0d3e3c59652bcf684011b2b14c516f645fd7248b8e2d85f7a5600005a908b140"},"blocks":{"#---frontmatter---":[1,8],"#The Backyard Adventurer":[9,76],"#The Backyard Adventurer##Summary":[12,17],"#The Backyard Adventurer##Main Ideas":[18,29],"#The Backyard Adventurer##Main Ideas#{1}":[19,19],"#The Backyard Adventurer##Main Ideas#{2}":[20,20],"#The Backyard Adventurer##Main Ideas#{3}":[21,21],"#The Backyard Adventurer##Main Ideas#{4}":[22,22],"#The Backyard Adventurer##Main Ideas#{5}":[23,23],"#The Backyard Adventurer##Main Ideas#{6}":[24,24],"#The Backyard Adventurer##Main Ideas#{7}":[25,25],"#The Backyard Adventurer##Main Ideas#{8}":[26,26],"#The Backyard Adventurer##Main Ideas#{9}":[27,29],"#The Backyard Adventurer##Tools":[30,37],"#The Backyard Adventurer##Tools#{1}":[31,37],"#The Backyard Adventurer##Chapters":[38,52],"#The Backyard Adventurer##Chapters#{1}":[39,39],"#The Backyard Adventurer##Chapters#{2}":[40,40],"#The Backyard Adventurer##Ch